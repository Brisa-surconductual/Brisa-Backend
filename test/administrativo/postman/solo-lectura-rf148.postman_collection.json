      "name": "Bloqueos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403 y ErrorApi RF-148', () => {",
              "  pm.response.to.have.status(403);",
              "  const error = pm.response.json();",
              "  pm.expect(error.status).to.eql(403);",
              "  pm.expect(error.codigo).to.eql('ESCRITURA_NO_PERMITIDA');",
              "  pm.expect(error.mensaje).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
