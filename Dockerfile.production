FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global --ignore-scripts pnpm@11.17.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
COPY prisma.config.ts ./
# Allow slow registry responses while keeping lockfile and supply-chain checks.
RUN pnpm install --frozen-lockfile --fetch-timeout=300000 --network-concurrency=4
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build pnpm exec prisma generate

COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
COPY scripts/check-production.cjs ./scripts/check-production.cjs
RUN pnpm run build \
    && test -f dist/src/main.js \
    && test -f dist/src/modules/usuarios/infrastructure/email/templates/recuperacion-constrasena.html \
    && pnpm prune --prod \
    && NODE_PATH=/app/dist node scripts/check-production.cjs

FROM node:22-bookworm-slim AS production

ENV NODE_ENV=production
ENV PORT=3000
ENV NODE_PATH=/app/dist
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./

USER node
EXPOSE 3000
CMD ["node", "dist/src/main.js"]
