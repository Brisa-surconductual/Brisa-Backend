DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/brisa
PORT=3000
NODE_ENV=development

# Use at least 32 random bytes. Never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=28800
AUTH_COOKIE_NAME=brisa_access_token
CSRF_COOKIE_NAME=brisa_csrf_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=strict
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
SESSION_INACTIVITY_MINUTES=15
SESSION_BACKGROUND_MINUTES=15

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Brisa <no-reply@example.com>
PASSWORD_RECOVERY_URL=http://localhost:5173/restablecer-contrasena
ACCOUNT_ACTIVATION_URL=http://localhost:5173/activar-cuenta

CONSENT_VERSION=1.0.0
CONSENT_TITLE=Consentimiento informado
CONSENT_CONTENT_URL=http://localhost:5173/consentimiento
